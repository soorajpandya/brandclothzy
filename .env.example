VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API URL (leave empty for local dev, set to deployed server URL for production)
# Example: https://brandclothzy-api.onrender.com
VITE_API_URL=

# EmailJS (for Contact form)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Payments: the browser no longer needs any Razorpay key. The server returns the public
# Key ID with each checkout order (GET /api/config), so VITE_RAZORPAY_KEY is unused.

# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Overview). Loads only after cookie consent.
VITE_CLARITY_PROJECT_ID=
