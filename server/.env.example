# ── BrandClothzy API server ─────────────────────────────────────────────────────────
# Copy to server/.env (git-ignored). Never put any of these in the frontend .env.

NODE_ENV=development
PORT=5000

# Storefront origins allowed to call the API (comma-separated). Required in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_SITE_URL=https://brandclothzy.com

# Razorpay — use TEST keys (rzp_test_…) for development. Live keys are refused unless
# NODE_ENV=production, or ALLOW_LIVE_PAYMENTS_IN_DEV=true is set deliberately.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Webhook secret is SEPARATE from the key secret: Razorpay Dashboard → Settings → Webhooks.
# Webhook URL: https://<your-api-host>/api/webhooks/razorpay
# Events: payment.authorized, payment.captured, payment.failed, order.paid, refund.created, refund.processed
RAZORPAY_WEBHOOK_SECRET=
# server = the API captures verified authorized payments (default). manual = leave them for ops.
RAZORPAY_CAPTURE_MODE=server
# ALLOW_LIVE_PAYMENTS_IN_DEV=false

# Firebase Admin (needed to verify sign-ins and write orders). Either a path to a
# service-account JSON file (Firebase Console → Project settings → Service accounts),
# or the JSON itself on one line.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=brandclothzy
FIREBASE_DATABASE_URL=https://brandclothzy-default-rtdb.firebaseio.com

# SMTP for transactional emails (order confirmation, welcome). Unset = logged, not sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BrandClothzy" <orders@brandclothzy.com>
