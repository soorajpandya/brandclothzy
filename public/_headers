# Cache policy (Netlify / Cloudflare Pages format; other hosts ignore this file — see REMEDIATION.md)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/products/*
  Cache-Control: public, max-age=604800

/hero-*
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: no-cache
